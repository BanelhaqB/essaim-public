# Copie ce fichier en runner.env (jamais committé) et remplis-le.
CONTROL_URL=https://essaim.exemple.fr
# Le même secret que celui du Worker (npx wrangler secret put RUNNER_TOKEN), 32 caractères au moins.
RUNNER_TOKEN=
MACHINE=nuc
CAPACITY=1

# Identité des commits faits par les agents.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
